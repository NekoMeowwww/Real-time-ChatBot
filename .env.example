# 豆包实时语音API配置
# 请从火山引擎控制台获取以下凭证并配置到.env文件中

# API App ID
API_APP_ID=YOUR_APP_ID

# API Access Key
API_ACCESS_KEY=YOUR_ACCESS_KEY

# API App Key
API_APP_KEY=YOUR_APP_KEY

# 字幕服务Access Token
CAPTION_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# 服务器配置（可选）
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 开发环境（可选）
DEBUG=False
